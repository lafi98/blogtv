# ─────────────────────────────────────────────────────────────────────────────
# Hook & Hearth — environment variables
# Copy to `.env` for local development. In production, set these in your host's
# secret manager instead of shipping a .env file. Never commit real values.
# Everything here is read on the SERVER only; nothing is exposed to browsers
# except values that are public by nature (e.g. an AdSense publisher ID).
# ─────────────────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════════════════
# REQUIRED IN PRODUCTION
#   SITE_URL, APP_SECRET, ANTHROPIC_API_KEY, CRON_SECRET  (+ ALLOW_INDEXING=true at launch)
# ════════════════════════════════════════════════════════════════════════════

# Public base URL of the site, no trailing slash. Used for canonicals, sitemap, OG tags.
SITE_URL=http://localhost:4321

# Search-engine indexing. Keep "false" during development/testing and on staging.
# When false, robots.txt disallows everything and every page is noindex — the admin shows
# a red warning while a production build runs with indexing blocked.
# ⚠ Set ALLOW_INDEXING=true on the LIVE site when it is ready for search engines,
#   otherwise Google will never index it.
ALLOW_INDEXING=false

# Long random string (≥ 32 chars) used to sign tokens and hash IPs.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production. In development a throwaway secret is created in data/.dev-secret.
APP_SECRET=

# Storage locations (relative to the project root unless absolute).
DATA_DIR=./data
# DATABASE_PATH=./data/site.db
# UPLOADS_DIR=./data/uploads

# Set to "true" when running behind a reverse proxy/CDN that sets X-Forwarded-For
# (needed for accurate per-IP rate limiting). Leave false if exposed directly.
TRUST_PROXY=false

# ── Scheduler ───────────────────────────────────────────────────────────────
# Shared secret (≥ 24 chars) for the cron endpoints:
#   GET/POST /api/cron/daily-publish   — daily AI publishing (call every 15 min)
#   GET/POST /api/cron/publish         — publish due scheduled articles
# Send it as "Authorization: Bearer <CRON_SECRET>". Without it the endpoints refuse (503).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Claude / Anthropic (AI publishing) ──────────────────────────────────────
# Server-side only. Never prefix with PUBLIC_, never put it in client code, never commit it.
ANTHROPIC_API_KEY=
# Model used for topic ideas, research, drafting and review.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, more tokens)
AI_EFFORT=high
# Allow the research step to use Anthropic's server-side web search tool
# (web search must be enabled for your organisation in the Anthropic Console).
AI_WEB_SEARCH=true
# Development only: use a simulated Claude client (no API calls, returns a sample article)
# to try the admin workflow without a key. Ignored in production builds.
# AI_SIMULATE=true

# ── Advertising (Google AdSense) ─────────────────────────────────────────────
# Ads are OFF by default. Turning them on needs: a real publisher ID + slot IDs
# (Admin → Settings → Ads) and the admin toggle. This switch overrides everything:
ADS_DISABLED=false
# Optional default for the publisher ID (format ca-pub-0000000000000000). Leave empty
# until Google gives you one. The admin setting takes precedence if filled in.
ADSENSE_CLIENT_ID=

# ── Analytics (optional; also configurable in Admin → Settings → Analytics) ─
# none | ga4 | plausible
ANALYTICS_PROVIDER=none
# GA4 measurement ID (G-XXXXXXXXXX) — only if ANALYTICS_PROVIDER=ga4
GA_MEASUREMENT_ID=
# Plausible site domain (e.g. example.com) — only if ANALYTICS_PROVIDER=plausible
PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# ── Email (newsletter double opt-in + contact notifications) ────────────────
# none | resend | postmark   ("none" logs emails to the server console)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM="Hook & Hearth <hello@example.com>"
# Where contact-form notifications go (optional).
CONTACT_NOTIFY_TO=

# ── Spam protection (optional Cloudflare Turnstile) ─────────────────────────
# If both are set, contact and newsletter forms require a Turnstile token.
# Turnstile loads a third-party script, so mention it in your privacy policy.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── First admin account (used once by `npm run admin:create`) ───────────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

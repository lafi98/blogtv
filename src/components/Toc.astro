---
import type { TocItem } from '../lib/content/markdown';
interface Props {
  items: TocItem[];
  id: string;
}
const { items, id } = Astro.props;
---
{items.length >= 3 && (
  <nav class="toc" aria-labelledby={id}>
    <h2 id={id}>On this page</h2>
    <ol>
      {items.map((t) => <li class={`toc-${t.level}`}><a href={`#${t.id}`}>{t.text}</a></li>)}
    </ol>
  </nav>
)}

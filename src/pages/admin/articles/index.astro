---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ARTICLE_STATUSES, listAdminArticles, type ArticleStatus } from '../../../lib/repos/articles';

const statusRaw = Astro.url.searchParams.get('status') ?? '';
const status = (ARTICLE_STATUSES as string[]).includes(statusRaw) ? (statusRaw as ArticleStatus) : '';
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const size = 50;
const { items, total } = listAdminArticles({ status, q, limit: size, offset: (page - 1) * size });
const fmt = (iso: string | null) => (iso ? iso.slice(0, 16).replace('T', ' ') : '—');
const tabs: [string, string][] = [['', 'All'], ['draft', 'Drafts'], ['review', 'Awaiting review'], ['scheduled', 'Scheduled'], ['published', 'Published'], ['archived', 'Archived']];
---
<AdminLayout title="Articles">
  <div class="toolbar">
    <h1 style="margin:0">Articles</h1>
    <span class="spacer"></span>
    <a class="btn btn-primary" href="/admin/articles/new">+ New article</a>
  </div>
  <nav class="tabs" aria-label="Filter by status">
    {tabs.map(([s, label]) => <a href={s ? `/admin/articles?status=${s}` : '/admin/articles'} aria-current={status === s ? 'page' : undefined}>{label}</a>)}
  </nav>
  <form method="get" class="toolbar" role="search">
    {status && <input type="hidden" name="status" value={status} />}
    <label for="aq" class="visually-hidden">Search titles</label>
    <input id="aq" type="search" name="q" value={q} placeholder="Search title or slug" style="max-width:320px" />
    <button class="btn" type="submit">Search</button>
  </form>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Title</th><th>Status</th><th>Checks</th><th>Category</th><th>Published / scheduled (UTC)</th><th>Words</th></tr></thead>
      <tbody>
        {items.map((a) => (
          <tr>
            <td><a href={`/admin/articles/${a.id}`}><strong>{a.title}</strong></a><br /><small class="muted">/blog/{a.slug}{a.aiAssisted && ' · AI-assisted'}</small></td>
            <td><span class={`pill pill-${a.status}`}>{a.status}</span></td>
            <td>{a.validationStatus ? <span class={`pill pill-${a.validationStatus}`}>{a.validationStatus}</span> : <span class="muted">—</span>}</td>
            <td>{a.categoryName ?? '—'}</td>
            <td>{a.status === 'scheduled' ? fmt(a.scheduledFor) : fmt(a.publishedAt)}</td>
            <td>{a.wordCount}</td>
          </tr>
        ))}
        {items.length === 0 && <tr><td colspan="6" class="muted">No articles found.</td></tr>}
      </tbody>
    </table>
  </div>
  <p class="muted">{total} article(s).
    {page > 1 && <a href={`?status=${status}&q=${encodeURIComponent(q)}&page=${page - 1}`}>← Previous</a>}
    {page * size < total && <a href={`?status=${status}&q=${encodeURIComponent(q)}&page=${page + 1}`}>Next →</a>}
  </p>
</AdminLayout>

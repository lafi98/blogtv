---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { DOMAIN_RE, GA4_ID_RE, getSettings, saveSettings } from '../../../lib/settings';
import { setFlash } from '../../../lib/admin/flash';
import { audit } from '../../../lib/db';

const a = getSettings('analytics');
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const provider = String(fd.get('provider'));
  const ga = String(fd.get('gaMeasurementId') ?? '').trim();
  const domain = String(fd.get('plausibleDomain') ?? '').trim();
  const errors: string[] = [];
  if (!['none', 'ga4', 'plausible'].includes(provider)) errors.push('Unknown provider.');
  if (provider === 'ga4' && !GA4_ID_RE.test(ga)) errors.push('GA4 measurement ID must look like G-XXXXXXXXXX.');
  if (provider === 'plausible' && !DOMAIN_RE.test(domain)) errors.push('Enter the domain registered in Plausible (e.g. example.com).');
  if (errors.length) setFlash(Astro.cookies, 'error', errors.join(' '));
  else {
    saveSettings('analytics', { provider: provider as typeof a.provider, gaMeasurementId: ga, plausibleDomain: domain, requireConsent: fd.get('requireConsent') === 'on' || provider === 'ga4' });
    audit('settings.analytics', { userId: Astro.locals.user!.id, details: provider });
    setFlash(Astro.cookies, 'success', 'Analytics settings saved.');
  }
  return Astro.redirect('/admin/settings/analytics', 303);
}
const csrf = Astro.locals.csrfToken;
---
<AdminLayout title="Analytics">
  <h1>Analytics</h1>
  <p class="muted">No tracking IDs are hard-coded. Scripts load only through the consent controller. Enabling analytics updates the Privacy and Cookie policies automatically.</p>
  <form method="post" class="card">
    <input type="hidden" name="_csrf" value={csrf} />
    <fieldset class="field"><legend><strong>Provider</strong></legend>
      <label class="check"><input type="radio" name="provider" value="none" checked={a.provider === 'none'} /> None</label>
      <label class="check"><input type="radio" name="provider" value="ga4" checked={a.provider === 'ga4'} /> Google Analytics 4 (always waits for consent)</label>
      <label class="check"><input type="radio" name="provider" value="plausible" checked={a.provider === 'plausible'} /> Plausible (cookieless)</label>
    </fieldset>
    <div class="grid grid-2">
      <div class="field"><label for="gaMeasurementId">GA4 measurement ID</label><input id="gaMeasurementId" name="gaMeasurementId" type="text" value={a.gaMeasurementId} placeholder="G-…" /></div>
      <div class="field"><label for="plausibleDomain">Plausible site domain</label><input id="plausibleDomain" name="plausibleDomain" type="text" value={a.plausibleDomain} /></div>
    </div>
    <label class="check"><input type="checkbox" name="requireConsent" checked={a.requireConsent} /> Plausible: wait for analytics consent too (recommended unless you have confirmed it isn't needed where you operate)</label>
    <p style="margin-top:1rem"><button class="btn btn-primary" type="submit">Save</button></p>
  </form>
</AdminLayout>

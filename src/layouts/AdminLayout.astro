---
import '../styles/admin.css';
import adminJs from '../scripts/admin.js?url';
import { countByStatus } from '../lib/repos/articles';
import { countNewMessages } from '../lib/repos/messages';
import { getSettings } from '../lib/settings';
import { config } from '../lib/config';

interface Props {
  title: string;
  /** Auto-refresh interval in seconds (used while an AI run is in progress). */
  refresh?: number;
}
const { title, refresh } = Astro.props;
const flash = Astro.locals.flash;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const counts = user ? countByStatus() : null;
const newMessages = user ? countNewMessages() : 0;
const site = getSettings('site');
const cur = (href: string, exact = false) => (exact ? path === href : path === href || path.startsWith(href + '/')) ? 'page' : undefined;
const statusCur = (s: string) => (path === '/admin/articles' && Astro.url.searchParams.get('status') === s ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · {site.name}</title>
    {refresh && <meta http-equiv="refresh" content={String(refresh)} />}
    <script is:inline src={adminJs} nonce={Astro.locals.nonce} defer></script>
  </head>
  <body>
    <a class="skip-link" href="#admin-main">Skip to content</a>
    {user ? (
      <div class="admin">
        <nav class="admin-nav" aria-label="Admin">
          <a class="admin-brand" href="/admin">{site.name} · Admin</a>
          <ul class="nav-group">
            <li><a href="/admin" aria-current={cur('/admin', true)}>Dashboard</a></li>
          </ul>
          <h2>Content</h2>
          <ul class="nav-group">
            <li><a href="/admin/articles/new" aria-current={cur('/admin/articles/new', true)}>+ New article</a></li>
            <li><a href="/admin/articles" aria-current={path === '/admin/articles' && !Astro.url.searchParams.get('status') ? 'page' : undefined}>All articles</a></li>
            <li><a href="/admin/articles?status=draft" aria-current={statusCur('draft')}>Drafts <span class="badge">{counts?.draft}</span></a></li>
            <li><a href="/admin/articles?status=review" aria-current={statusCur('review')}>Awaiting review <span class="badge">{counts?.review}</span></a></li>
            <li><a href="/admin/articles?status=scheduled" aria-current={statusCur('scheduled')}>Scheduled <span class="badge">{counts?.scheduled}</span></a></li>
            <li><a href="/admin/articles?status=published" aria-current={statusCur('published')}>Published</a></li>
            <li><a href="/admin/categories" aria-current={cur('/admin/categories')}>Categories</a></li>
            <li><a href="/admin/authors" aria-current={cur('/admin/authors')}>Authors</a></li>
            <li><a href="/admin/media" aria-current={cur('/admin/media')}>Media library</a></li>
            <li><a href="/admin/topics" aria-current={cur('/admin/topics')}>AI Publisher</a></li>
            <li><a href="/admin/runs" aria-current={cur('/admin/runs')}>AI run log</a></li>
          </ul>
          <h2>Audience</h2>
          <ul class="nav-group">
            <li><a href="/admin/messages" aria-current={cur('/admin/messages')}>Messages {newMessages > 0 && <span class="badge">{newMessages}</span>}</a></li>
            <li><a href="/admin/subscribers" aria-current={cur('/admin/subscribers')}>Subscribers</a></li>
          </ul>
          <h2>Settings</h2>
          <ul class="nav-group">
            <li><a href="/admin/settings" aria-current={cur('/admin/settings', true)}>Site</a></li>
            <li><a href="/admin/settings/automation" aria-current={cur('/admin/settings/automation')}>Automation</a></li>
            <li><a href="/admin/settings/ads" aria-current={cur('/admin/settings/ads')}>Advertising</a></li>
            <li><a href="/admin/settings/consent" aria-current={cur('/admin/settings/consent')}>Cookies &amp; consent</a></li>
            <li><a href="/admin/settings/analytics" aria-current={cur('/admin/settings/analytics')}>Analytics</a></li>
            <li><a href="/admin/account" aria-current={cur('/admin/account')}>Account</a></li>
          </ul>
          <h2>Session</h2>
          <ul class="nav-group">
            <li><a href="/" target="_blank" rel="noopener">View site ↗</a></li>
            <li>
              <form method="post" action="/admin/logout">
                <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
                <button type="submit">Sign out ({user.email})</button>
              </form>
            </li>
          </ul>
        </nav>
        <main class="admin-main" id="admin-main" tabindex="-1">
          {config.isProd && !config.allowIndexing && (
            <div class="flash flash-error" role="alert"><strong>Search engines are blocked</strong> (ALLOW_INDEXING=false). That is right for staging; set <code>ALLOW_INDEXING=true</code> on the live site when you launch.</div>
          )}
          {flash && <div class={`flash flash-${flash.type}`} role={flash.type === 'error' ? 'alert' : 'status'}>{flash.text}</div>}
          <slot />
        </main>
      </div>
    ) : (
      <main class="admin-main" id="admin-main"><slot /></main>
    )}
  </body>
</html>

---
import '@fontsource-variable/fraunces/wght.css';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import siteJs from '../scripts/site.js?url';
import consentJs from '../scripts/consent.js?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { absoluteUrl, config } from '../lib/config';
import { ADSENSE_CLIENT_RE, getSettings } from '../lib/settings';
import { DEFAULT_OG_IMAGE, jsonLd, organizationLd, robotsContent, websiteLd, type PageMeta } from '../lib/seo';

interface Props {
  meta: PageMeta;
  structuredData?: object[];
  /** Pages that explain the site itself (legal, contact) and utility pages keep the chrome minimal. */
  draftBanner?: string;
}
const { meta, structuredData = [], draftBanner } = Astro.props;
const site = getSettings('site');
const nonce = Astro.locals.nonce;
const fullTitle = meta.path === '/' ? `${site.name} — ${site.tagline}` : `${meta.title} | ${site.name}`;
const canonical = meta.canonical || absoluteUrl(meta.path);
const image = meta.image ?? { ...DEFAULT_OG_IMAGE, alt: `${site.name} — ${site.tagline}` };
const imageUrl = absoluteUrl(image.url);
const ld = [organizationLd(), websiteLd(), ...structuredData];
// Lets Google verify site ownership for AdSense without loading any ad script before consent.
const adsenseAccount = ADSENSE_CLIENT_RE.test(getSettings('ads').clientId) ? getSettings('ads').clientId : '';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline nonce={nonce}>document.documentElement.classList.remove('no-js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent(meta.noindex)} />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf6f0" />
    {adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — latest articles`} href="/rss.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={meta.type ?? 'website'} />
    <meta property="og:title" content={meta.ogTitle || meta.title} />
    <meta property="og:description" content={meta.ogDescription || meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {meta.type === 'article' && meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
    {meta.type === 'article' && meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}
    {meta.type === 'article' && meta.section && <meta property="article:section" content={meta.section} />}
    {meta.type === 'article' && meta.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle || meta.title} />
    <meta name="twitter:description" content={meta.ogDescription || meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    {ld.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
    <script is:inline src={consentJs} nonce={nonce} defer></script>
    <script is:inline src={siteJs} nonce={nonce} defer></script>
    {config.turnstile.enabled && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" nonce={nonce} async defer></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {draftBanner && <div class="draft-banner" role="status">{draftBanner}</div>}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <div id="live-region" class="visually-hidden" aria-live="polite"></div>
  </body>
</html>
